--═══════════════════════════════════════════════════════════════
-- [3] UTILITÁRIOS
--═══════════════════════════════════════════════════════════════
local function criar(className, props, children)
    local ok, obj = pcall(Instance.new, className)
    if not ok or not obj then return nil end
    for k, v in pairs(props or {}) do pcall(function() obj[k] = v end) end
    for _, c in ipairs(children or {}) do pcall(function() c.Parent = obj end) end
    return obj
end

local function conectar(signal, fn)
    local conn = signal:Connect(function(...) pcall(fn, ...) end)
    table.insert(env.ZazakHub.Conns, conn)
    return conn
end

local function notificar(titulo, texto)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = tostring(titulo),
            Text = tostring(texto),
            Duration = 3,
        })
    end)
end

--═══════════════════════════════════════════════════════════════
-- [4] ANTI-HIT (genérico - funciona em qualquer boss)
--═══════════════════════════════════════════════════════════════
local AntiHit = {}
AntiHit.hooked = false

local RAGDOLL_STATES = {
    [Enum.HumanoidStateType.Physics] = true,
    [Enum.HumanoidStateType.Ragdoll] = true,
    [Enum.HumanoidStateType.FallingDown] = true,
}

local RAGDOLL_CLASSES = {
    BallSocketConstraint = true,
    NoCollisionConstraint = true,
    HingeConstraint = true,
    RigidConstraint = true,
}

function AntiHit.limparPersonagem(char)
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    pcall(function()
        -- Restaura HP se perdeu
        if hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end

        -- Desabilita ragdoll
        if AntiRagdoll.ativo then
            for state in pairs(RAGDOLL_STATES) do
                pcall(function() hum:SetStateEnabled(state, false) end)
            end
            pcall(function() hum.BreakJointsOnDeath = false end)
            pcall(function() hum.RequiresNeck = false end)

            if hum.PlatformStand then hum.PlatformStand = false end

            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end

            -- Remove constraints de ragdoll
            for _, d in ipairs(char:GetDescendants()) do
                if RAGDOLL_CLASSES[d.ClassName] then
                    pcall(function() d:Destroy() end)
                elseif d:IsA("Motor6D") and not d.Enabled then
                    d.Enabled = true
                end
            end
        end
    end)
end

function AntiHit.ativar()
    if AntiHit.hooked then return end
    AntiHit.hooked = true

    -- Loop contínuo: se o HP cair, restaura na hora
    RunService.Heartbeat:Connect(function()
        if not AntiHit.ativo then return end
        local char = LocalPlayer.Character
        if char then AntiHit.limparPersonagem(char) end
    end)

    conectar(LocalPlayer.CharacterAdded, function(char)
        task.wait(0.5)
        AntiHit.limparPersonagem(char)
    end)

    -- Tenta hook em TakeDamage se o executor permitir
    pcall(function()
        if hookmetamethod and newcclosure and getnamecallmethod then
            local old
            old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if AntiHit.ativo and method == "TakeDamage" then
                    if typeof(self) == "Instance" and self:IsA("Humanoid") then
                        local char = self.Parent
                        if char == LocalPlayer.Character then
                            return nil
                        end
                    end
                end
                return old(self, ...)
            end))
        end
    end)

    notificar("Zazak Hub", "Anti-Hit ATIVO (todos os bosses)")
end

AntiHit.ativo = Config.AntiHit

