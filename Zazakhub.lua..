-- [7] INSTANT STEAL
--═══════════════════════════════════════════════════════════════
local Steal = { ativo = Config.InstantSteal }

local function pegarPrompt(ovo)
    if not ovo then return nil end
    local ok, p = pcall(function()
        return ovo:FindFirstChildWhichIsA("ProximityPrompt", true)
    end)
    return ok and p or nil
end

local function roubarOvo(ovo)
    if not ovo or not ovo.Parent then return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local prompt = pegarPrompt(ovo)

    if not hrp or not prompt then return false end

    pcall(function() prompt.HoldDuration = 0 end)
    pcall(function() prompt.MaxActivationDistance = math.huge end)

    -- Teleporta até o ovo
    pcall(function()
        hrp.CFrame = CFrame.new(ovo:GetPivot().Position + Vector3.new(0, 3, 0))
    end)

    task.wait(0.05)

    pcall(function()
        if fireproximityprompt then fireproximityprompt(prompt) end
    end)
    pcall(function() prompt:InputHoldBegin() end)
    pcall(function() prompt:InputHoldEnd() end)

    return true
end

local function ovoMaisProximo()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local melhor, menorDist = nil, Config.RaioScan

    pcall(function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find("egg") or obj.Name:lower():find("ovo")) then
                local prompt = pegarPrompt(obj)
                if prompt and prompt.Enabled then
                    local dist = (hrp.Position - obj:GetPivot().Position).Magnitude
                    if dist < menorDist then
                        menorDist = dist
                        melhor = obj
                    end
                end
            end
        end
    end)

    return melhor
end

local function loopSteal()
    task.spawn(function()
        while env.ZazakHub.Ativo do
            if Steal.ativo then
                local ovo = ovoMaisProximo()
                if ovo then roubarOvo(ovo) end
            end
            task.wait(Config.IntervaloScan)
        end
    end)
end

