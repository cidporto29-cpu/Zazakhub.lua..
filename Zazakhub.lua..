-- [6] ANTI-KICK
--═══════════════════════════════════════════════════════════════
local function ativarAntiKick()
    pcall(function()
        if hookfunction then
            local old
            old = hookfunction(LocalPlayer.Kick, function(self, msg)
                if Config.AntiKick then
                    warn("[Zazak] Kick bloqueado: " .. tostring(msg))
                    return nil
                end
                return old(self, msg)
            end)
        end
    end)

    pcall(function()
        if getrawmetatable and setreadonly and newcclosure and getnamecallmethod then
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local old = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local m = getnamecallmethod()
                if Config.AntiKick and m == "Kick" and typeof(self) == "Instance" and self:IsA("Player") then
                    warn("[Zazak] Kick bloqueado (meta)")
                    return nil
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
        end
    end)
end

