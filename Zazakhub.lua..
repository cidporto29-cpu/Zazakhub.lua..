-- [9] INICIALIZAÇÃO
--═══════════════════════════════════════════════════════════════
local function init()
    pcall(GUI.criar)
    pcall(AntiHit.ativar)
    pcall(ativarAntiKick)
    pcall(loopSteal)

    notificar("ZAZAK HUB", "Carregado! Anti-Hit + Instant Steal")
    print("[Zazak Hub] Carregado")
    print("  Anti-Hit: " .. (AntiHit.ativo and "ON" or "OFF"))
    print("  Instant Steal: " .. (Steal.ativo and "ON" or "OFF"))
    print("  Clique no 'Z' pra abrir o painel")
end

pcall(init)

-- Unload
env.ZazakHub.Unload = function()
    env.ZazakHub.Ativo = false
    for _, c in ipairs(env.ZazakHub.Conns) do
        pcall(function() c:Disconnect() end)
    end
    if GUI.gui then pcall(function() GUI.gui:Destroy() end) end
    print("[Zazak Hub] Descarregado")
end
