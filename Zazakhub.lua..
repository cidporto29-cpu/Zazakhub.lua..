-- [8] INTERFACE - "Z" COM RAIOS
--═══════════════════════════════════════════════════════════════
local GUI = { aberto = false }

function GUI.criar()
    local gui = criar("ScreenGui", {
        Name = "ZazakHub",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    })
    gui.Parent = PlayerGui
    GUI.gui = gui

    -- Container principal (arrastável)
    local main = criar("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 70, 0, 70),
        Position = UDim2.new(0, 30, 0, 200),
        BackgroundTransparency = 1,
        Active = true,
        Draggable = true,
    })
    main.Parent = gui

    -- Anel externo (raios)
    local raios = criar("Frame", {
        Name = "Raios",
        Size = UDim2.new(0, 70, 0, 70),
        BackgroundColor3 = Config.Cores.Roxo,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
    }, {
        criar("UICorner", {CornerRadius = UDim.new(1, 0)}),
    })
    raios.Parent = main

    -- Botão circular "Z"
    local btnZ = criar("TextButton", {
        Name = "BtnZ",
        Size = UDim2.new(0, 60, 0, 60),
        Position = UDim2.new(0.5, -30, 0.5, -30),
        BackgroundColor3 = Config.Cores.Painel,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBlack,
        TextSize = 32,
        TextColor3 = Config.Cores.RoxoClaro,
        Text = "Z",
        AutoButtonColor = false,
    }, {
        criar("UICorner", {CornerRadius = UDim.new(1, 0)}),
        criar("UIStroke", {Color = Config.Cores.Roxo, Thickness = 2}),
    })
    btnZ.Parent = main

    -- Raios pequenos ao redor (6 traços)
    local raiosPequenos = {}
    for i = 1, 6 do
        local angulo = (i / 6) * math.pi * 2
        local x = math.cos(angulo) * 40
        local y = math.sin(angulo) * 40

        local raio = criar("Frame", {
            Size = UDim2.new(0, 3, 0, 12),
            Position = UDim2.new(0.5, x - 1, 0.5, y - 6),
            BackgroundColor3 = Config.Cores.Roxo,
            BorderSizePixel = 0,
            Rotation = math.deg(angulo) + 90,
        }, {
            criar("UICorner", {CornerRadius = UDim.new(1, 0)}),
        })
        raio.Parent = main
        table.insert(raiosPequenos, raio)
    end

    -- Rotação dos raios
    local rot = 0
    RunService.RenderStepped:Connect(function(dt)
        rot = (rot + dt * 60) % 360
        for i, raio in ipairs(raiosPequenos) do
            local angulo = math.rad(rot + (i / #raiosPequenos) * 360)
            local x = math.cos(angulo) * 40
            local y = math.sin(angulo) * 40
            raio.Position = UDim2.new(0.5, x - 1.5, 0.5, y - 6)
            raio.Rotation = math.deg(angulo) + 90
        end
    end)

    -- Painel de toggles (aparece quando clica no Z)
    local painel = criar("Frame", {
        Name = "Painel",
        Size = UDim2.new(0, 200, 0, 180),
        Position = UDim2.new(0, 110, 0, 200),
        BackgroundColor3 = Config.Cores.Fundo,
        BorderSizePixel = 0,
        Visible = false,
    }, {
        criar("UICorner", {CornerRadius = UDim.new(0, 10)}),
        criar("UIStroke", {Color = Config.Cores.Roxo, Thickness = 1.5}),
    })
    painel.Parent = gui

    -- Título
    criar("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Config.Cores.Roxo,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBlack,
        TextSize = 14,
        TextColor3 = Color3.new(1, 1, 1),
        Text = "ZAZAK HUB",
    }, {
        criar("UICorner", {CornerRadius = UDim.new(0, 10)}),
    }).Parent = painel

    -- Função criar toggle
    local function criarToggle(nome, chave, y)
        local btn = criar("TextButton", {
            Size = UDim2.new(1, -20, 0, 32),
            Position = UDim2.new(0, 10, 0, y),
            BackgroundColor3 = Config.Cores.Painel,
            BorderSizePixel = 0,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextColor3 = Config.Cores.Texto,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  " .. nome,
        }, {
            criar("UICorner", {CornerRadius = UDim.new(0, 6)}),
            criar("UIStroke", {Color = Config.Cores.Roxo, Thickness = 1}),
            criar("TextLabel", {
                Name = "Status",
                Size = UDim2.new(0, 50, 1, 0),
                Position = UDim2.new(1, -55, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = "[ON]",
            }),
        })
        btn.Parent = painel
        return btn
    end

    local btnAntiHit = criarToggle("Anti-Hit", "AntiHit", 40)
    local btnSteal = criarToggle("Instant Steal", "InstantSteal", 76)
    local btnRagdoll = criarToggle("Anti-Ragdoll", "AntiRagdoll", 112)
    local btnKick = criarToggle("Anti-Kick", "AntiKick", 148)

    -- Atualiza visual
    local function atualizar(btn, valor)
        local st = btn:FindFirstChild("Status")
        if not st then return end
        st.Text = valor and "[ON]" or "[OFF]"
        st.TextColor3 = valor and Config.Cores.Verde or Config.Cores.Cinza
    end

    atualizar(btnAntiHit, AntiHit.ativo)
    atualizar(btnSteal, Steal.ativo)
    atualizar(btnRagdoll, AntiRagdoll.ativo)
    atualizar(btnKick, Config.AntiKick)

    btnAntiHit.MouseButton1Click:Connect(function()
        AntiHit.ativo = not AntiHit.ativo
        Config.AntiHit = AntiHit.ativo
        atualizar(btnAntiHit, AntiHit.ativo)
        notificar("Zazak", "Anti-Hit: " .. (AntiHit.ativo and "ON" or "OFF"))
    end)

    btnSteal.MouseButton1Click:Connect(function()
        Steal.ativo = not Steal.ativo
        Config.InstantSteal = Steal.ativo
        atualizar(btnSteal, Steal.ativo)
        notificar("Zazak", "Instant Steal: " .. (Steal.ativo and "ON" or "OFF"))
    end)

    btnRagdoll.MouseButton1Click:Connect(function()
        AntiRagdoll.ativo = not AntiRagdoll.ativo
        Config.AntiRagdoll = AntiRagdoll.ativo
        atualizar(btnRagdoll, AntiRagdoll.ativo)
        notificar("Zazak", "Anti-Ragdoll: " .. (AntiRagdoll.ativo and "ON" or "OFF"))
    end)

    btnKick.MouseButton1Click:Connect(function()
        Config.AntiKick = not Config.AntiKick
        atualizar(btnKick, Config.AntiKick)
        notificar("Zazak", "Anti-Kick: " .. (Config.AntiKick and "ON" or "OFF"))
    end)

    -- Abre/fecha painel
    btnZ.MouseButton1Click:Connect(function()
        GUI.aberto = not GUI.aberto
        painel.Visible = GUI.aberto
    end)

    -- Atalho: segurar o Z por 1s fecha tudo
    return gui
end

